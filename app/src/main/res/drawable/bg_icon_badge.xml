<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="40dp"
                android:startColor="#3329B6F6"
                android:endColor="#0029B6F6" />
        </shape>
    </item>
    <item android:width="52dp" android:height="52dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/bg_panel_light" />
            <stroke android:width="1.5dp" android:color="@color/accent_blue" />
        </shape>
    </item>
</layer-list>
