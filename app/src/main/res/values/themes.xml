<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.RouterManagerPro" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/accent_blue_deep</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:colorBackground">@color/bg_deep_black</item>
        <item name="colorSurface">@color/bg_panel</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>

        <item name="android:statusBarColor">@color/bg_deep_black</item>
        <item name="android:navigationBarColor">@color/bg_deep_black</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Theme.RouterManagerPro.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_deep_black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.RouterManagerPro</item>
    </style>

    <style name="CardStyle3D">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">10dp</item>
        <item name="strokeColor">@color/accent_blue_deep</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">18dp</item>
    </style>

    <style name="PrimaryButton3D" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent_blue</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:elevation">6dp</item>
        <item name="rippleColor">@color/accent_cyan</item>
    </style>

    <style name="OutlineButton3D" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/accent_blue</item>
        <item name="android:textColor">@color/accent_blue</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="LabelText">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="ValueText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
